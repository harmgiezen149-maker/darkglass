{
  "version": 2,
  "functions": {
    "api/chat.js": {
      "maxDuration": 300
    },
    "api/blocks-sync.js": {
      "maxDuration": 300
    },
    "api/analyse.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/blocks-sync?cron=1",
      "schedule": "17 6 * * 1"
    }
  ]
}
